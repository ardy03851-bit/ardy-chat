rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(roomId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.memberIds;
    }
    match /attachments/{roomId}/{uid}/{attachmentId}/{filename} {
      allow read: if member(roomId);
      allow create: if member(roomId) && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)|application/pdf|text/plain');
      allow update: if false;
      allow delete: if member(roomId) && request.auth.uid == uid;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
