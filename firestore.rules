rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function validProfile(p) {
      return p.keys().hasOnly(['displayName', 'photoURL']) &&
        p.displayName is string && p.displayName.size() > 0 && p.displayName.size() <= 50 &&
        p.photoURL is string && p.photoURL.size() <= 2048;
    }
    match /users/{uid} {
      // Only exact-ID lookups are supported, never a user directory.
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if self(uid) &&
        request.resource.data.keys().hasOnly(['uid','displayName','photoURL','bio','lastActive']) &&
        request.resource.data.uid == uid &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 50 &&
        request.resource.data.bio is string && request.resource.data.bio.size() <= 100 &&
        request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048;
      allow delete: if false;
      match /saved/{id} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid) &&
          request.resource.data.keys().hasOnly(['roomId','messageId','text','authorName','roomName','savedAt']) &&
          member(request.resource.data.roomId) &&
          request.resource.data.text is string && request.resource.data.text.size() <= 8000;
      }
    }
    match /invites/{token} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create, update: if signedIn() &&
        request.resource.data.keys().hasOnly(['roomId','roomName','createdBy','expiresAt']) &&
        get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId == request.auth.uid &&
        get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.inviteCode == token &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
    match /rooms/{roomId} {
      function existingMember() { return signedIn() && request.auth.uid in resource.data.memberIds; }
      function validJoin() {
        let uid = request.auth.uid;
        let code = resource.data.inviteCode;
        let invite = get(/databases/$(database)/documents/invites/$(code));
        return resource.data.type == 'space' &&
          !(uid in resource.data.memberIds) &&
          invite.data.roomId == roomId && invite.data.expiresAt > request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','memberProfiles']) &&
          request.resource.data.memberIds == resource.data.memberIds.concat([uid]) &&
          request.resource.data.memberProfiles.diff(resource.data.memberProfiles).affectedKeys().hasOnly([uid]) &&
          validProfile(request.resource.data.memberProfiles[uid]);
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/rooms/$(roomId)) || existingMember());
      allow list: if existingMember();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['name','description','type','memberIds','memberProfiles','ownerId','inviteCode','createdAt','lastMessage','lastMessageAt']) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 48 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 160 &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberProfiles is map &&
        validProfile(request.resource.data.memberProfiles[request.auth.uid]) &&
        request.resource.data.memberProfiles.keys().hasOnly(request.resource.data.memberIds) &&
        ((request.resource.data.type == 'space' &&
          request.resource.data.memberIds == [request.auth.uid] &&
          request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() == 64) ||
         (request.resource.data.type == 'dm' &&
          request.resource.data.memberIds.size() == 2 &&
          request.resource.data.memberIds[0] != request.resource.data.memberIds[1] &&
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.inviteCode == ''));
      allow update: if signedIn() && (
        (existingMember() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageAt']) &&
          request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 8000) ||
        validJoin()
      );
      allow delete: if false;
      match /messages/{messageId} {
        function validAttachment(a) {
          return a == null || (
            a is map && a.keys().hasOnly(['url','path','name','type','size']) &&
            a.url is string && a.url.size() <= 4096 && a.name is string && a.name.size() <= 255 &&
            a.path is string && a.path.matches('attachments/' + roomId + '/' + request.auth.uid + '/.*') &&
            a.size is number && a.size > 0 && a.size <= 10485760 &&
            a.type in ['image/jpeg','image/png','image/webp','image/gif','application/pdf','text/plain']);
        }
        function reactionChange(key) {
          let before = resource.data.reactions.get(key, []);
          let after = request.resource.data.reactions.get(key, []);
          return after is list && (
            after == before ||
            after == before.removeAll([request.auth.uid]) ||
            (!(request.auth.uid in before) && after == before.concat([request.auth.uid])));
        }
        function validReactions() {
          return request.resource.data.reactions is map &&
            request.resource.data.reactions.keys().hasOnly(['heart','thumbs','sparkles']) &&
            reactionChange('heart') && reactionChange('thumbs') && reactionChange('sparkles');
        }
        allow read: if member(roomId);
        allow create: if member(roomId) &&
          request.resource.data.keys().hasOnly(['text','senderId','senderName','senderPhoto','createdAt','reactions','pinned','attachment','replyTo']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName &&
          request.resource.data.senderPhoto is string && request.resource.data.senderPhoto.size() <= 2048 &&
          request.resource.data.text is string && request.resource.data.text.size() <= 8000 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.reactions == {} && request.resource.data.pinned == false &&
          validAttachment(request.resource.data.get('attachment', null)) &&
          (request.resource.data.text.size() > 0 || request.resource.data.get('attachment', null) != null);
        allow update: if member(roomId) && (
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt']) &&
            request.resource.data.text is string && request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 8000 && resource.data.get('deleted', false) == false) ||
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','deleted','attachment','reactions']) &&
            request.resource.data.deleted == true && request.resource.data.text == '' &&
            request.resource.data.attachment == null && request.resource.data.reactions == {}) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
            resource.data.get('deleted', false) == false && validReactions()) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']) &&
            request.resource.data.pinned is bool && resource.data.get('deleted', false) == false)
        );
        allow delete: if false;
      }
      match /typing/{uid} {
        allow read: if member(roomId);
        allow create, update: if member(roomId) && self(uid) &&
          request.resource.data.keys().hasOnly(['name','at']) &&
          request.resource.data.name is string && request.resource.data.name.size() <= 50 &&
          request.resource.data.at == request.time;
        allow delete: if member(roomId) && self(uid);
      }
    }
    match /calls/{callId} {
      function participant() { return signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid); }
      allow read: if participant();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['roomId','callerId','callerName','calleeId','participantIds','video','status','offer','createdAt']) &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.calleeId != request.auth.uid &&
        request.resource.data.participantIds == [request.auth.uid, request.resource.data.calleeId] &&
        member(request.resource.data.roomId) &&
        get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.type == 'dm' &&
        request.resource.data.calleeId in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.memberIds &&
        request.resource.data.status == 'ringing' &&
        request.resource.data.createdAt == request.time;
      allow update: if participant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status']) &&
        request.resource.data.status in ['ringing','connecting','connected','ended','declined','unanswered','failed'];
      allow delete: if false;
      match /{side}/{candidateId} {
        function parent() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        allow read: if signedIn() && (parent().callerId == request.auth.uid || parent().calleeId == request.auth.uid);
        allow create: if signedIn() && (
          (side == 'callerCandidates' && parent().callerId == request.auth.uid) ||
          (side == 'calleeCandidates' && parent().calleeId == request.auth.uid));
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
